{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "homelab",
	"version": "0.1.0",
	"identifier": "dev.caorushizi.labmap",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"title": "homelab",
				"width": 1100,
				"height": 720,
				"minWidth": 1100,
				"minHeight": 720,
				"center": true,
				"resizable": true,
				"theme": "Dark",
				"fullscreen": false,
				"decorations": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": {
					"x": 20,
					"y": 22
				}
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		}
	}
}
